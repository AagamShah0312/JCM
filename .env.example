# =============================================================================
# JCM environment — copy to .env and fill in secrets. Never commit .env.
# =============================================================================

# Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Database (PostgreSQL + pgvector). SQLite is used automatically if DB_ENGINE is sqlite3.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=judicial_case_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# True = run tasks in-process (no worker needed). False in Docker/production.
CELERY_TASK_ALWAYS_EAGER=True

# JWT / admin bootstrap codes
JWT_SECRET=
JWT_ALGORITHM=HS256
ADMIN_SIGNUP_CODE=JCM-ADMIN-SIGNUP-2026
ADMIN_LOGIN_CODE=JCM-ADMIN-LOGIN-2026

# AI provider abstraction: gemini | openai | anthropic | local
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
VECTOR_EMBEDDING_DIM=768
OPENAI_API_KEY=

# Object storage: local | s3  (S3-compatible: MinIO, AWS, R2, …)
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jcm-documents
S3_ACCESS_KEY=jcmminio
S3_SECRET_KEY=jcmminio123
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
SIGNED_URL_TTL=300

# Email (in-app notifications first; this is the later email hook)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# MFA (TOTP end-to-end). Set True to require authenticator codes.
MFA_ENABLED=False

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
